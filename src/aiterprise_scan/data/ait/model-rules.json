{
  "schema": "ait-model-rules/1",
  "version": "2026.11.17",
  "description": "Model-file analyzer rules (design doc 13 §5.3 `modelfiles`): rule metadata, pickle callable deny/allow lists, GGUF chat-template injection markers, ONNX operator domains, Keras Lambda bytecode tokens, format sniffers and analysis limits. First-party, curated. Lists are matched on the callable a pickle imports (GLOBAL / INST / STACK_GLOBAL): `module` matches exactly (or as a package prefix when `submodules` is true) and `names` are fnmatch patterns over the attribute name. Deny is checked first, including attribute traversal through dotted names (protocol 4+), so an allow entry can never hide a denied callable. Anything on neither list is reported as unknown (medium). An allow entry with `classes_only` accepts only undotted names that start with an upper-case letter (classes), never functions.",
  "quality_note": "No rule here has a measured false-positive rate yet. `fp_rate_measured` stays null until the rules are evaluated against a labelled corpus; do not quote these rules as measured.",
  "rules": {
    "ait.model.pickle.dangerous-global": {
      "severity": "critical",
      "verdict": "malicious",
      "confidence": 90,
      "description": "A pickle stream imports a callable on the deny list (process execution, eval/exec, dynamic import, network, native code, destructive filesystem operations or a nested deserializer). Unpickling the file runs that callable. Individual deny entries may lower severity/verdict for serializers that embed code by design (dill, cloudpickle).",
      "remediation": "Do not load this file. Treat its source as compromised; obtain the model from a trusted publisher in a non-executable format (safetensors, GGUF, ONNX) and verify its hash.",
      "maps_to": ["LLM03:2025 Supply Chain", "LLM04:2025 Data and Model Poisoning"],
      "references": ["https://docs.python.org/3/library/pickle.html#restricting-globals"],
      "quality": {"fp_rate_measured": null, "corpus": null, "evaluated_at": null}
    },
    "ait.model.pickle.unknown-global": {
      "severity": "medium",
      "verdict": "suspicious",
      "confidence": 50,
      "description": "A pickle stream imports callables that are on neither the deny list nor the known-safe list (often the publisher's own classes from a full-model pickle). Unpickling imports and may call them. Raised to high when the name traverses module attributes (a dotted name through a lower-case segment), a known way to reach a denied callable from an allowed module.",
      "remediation": "Review the listed callables. If they are your own classes, save weights only (state_dict to safetensors). Load untrusted pickles only with torch.load(weights_only=True) or inside an isolated sandbox.",
      "maps_to": ["LLM03:2025 Supply Chain"],
      "references": [],
      "quality": {"fp_rate_measured": null, "corpus": null, "evaluated_at": null}
    },
    "ait.model.pickle.unresolved-global": {
      "severity": "high",
      "verdict": "suspicious",
      "confidence": 70,
      "description": "A pickle imports a callable whose module or name cannot be determined statically (STACK_GLOBAL operands that are not constant strings, or copyreg extension codes). Legitimate serializers do not produce this; it is a common obfuscation technique.",
      "remediation": "Do not load this file unless its origin is trusted and the callable can be identified by other means.",
      "maps_to": ["LLM03:2025 Supply Chain", "LLM04:2025 Data and Model Poisoning"],
      "references": [],
      "quality": {"fp_rate_measured": null, "corpus": null, "evaluated_at": null}
    },
    "ait.model.pickle.format": {
      "severity": "info",
      "verdict": "benign",
      "confidence": 95,
      "description": "Pickle-based model file whose imported callables are all on the known-safe list. The format itself still lets a loader execute code, so a future or tampered copy of the same file may not be safe.",
      "remediation": "Prefer safetensors. If a pickle must be loaded, use torch.load(weights_only=True) and pin the file hash.",
      "maps_to": ["LLM03:2025 Supply Chain"],
      "references": [],
      "quality": {"fp_rate_measured": null, "corpus": null, "evaluated_at": null}
    },
    "ait.model.malformed": {
      "severity": "medium",
      "verdict": "unknown",
      "confidence": 80,
      "description": "The container is truncated, corrupt or internally inconsistent (bad pickle bytecode, unreadable ZIP, CRC mismatch, duplicate members, out-of-bounds safetensors header, broken GGUF/ONNX structure, missing signature, or a pickle disguised with a non-executable format's extension). Loaders differ in how they treat such files, which attackers use to evade scanners; anything found before the error still applies.",
      "remediation": "Re-download the file from its publisher and compare hashes. Do not load a malformed model from an untrusted source.",
      "maps_to": ["LLM03:2025 Supply Chain"],
      "references": [],
      "quality": {"fp_rate_measured": null, "corpus": null, "evaluated_at": null}
    },
    "ait.model.not-analysable": {
      "severity": "medium",
      "verdict": "unknown",
      "confidence": 90,
      "description": "Part or all of the file could not be analysed (LZ4 compression, encrypted or unsupported ZIP members, size/opcode caps reached, unrecognised content). This is not a clean result: the unanalysed part may contain anything.",
      "remediation": "Analyse the file with a tool that supports the format, or obtain the model in a non-executable format.",
      "maps_to": ["LLM03:2025 Supply Chain"],
      "references": [],
      "quality": {"fp_rate_measured": null, "corpus": null, "evaluated_at": null}
    },
    "ait.model.known-bad-hash": {
      "severity": "high",
      "verdict": "malicious",
      "confidence": 95,
      "description": "The file's SHA-256 or SHA-1 is one a public incident report names as malicious (`known-bad-hashes.json`, offline). Checked on the bytes before the format is, so a payload that is no valid model, such as an ELF named `.bin`, is still reported. The evidence links the report.",
      "remediation": "Do not load the file. Delete it, find out where it came from, and treat any machine that loaded it as compromised.",
      "maps_to": ["LLM03:2025 Supply Chain", "LLM04:2025 Data and Model Poisoning"],
      "references": [],
      "quality": {"fp_rate_measured": null, "corpus": null, "evaluated_at": null}
    },
    "ait.model.zip-slip": {
      "severity": "high",
      "verdict": "suspicious",
      "confidence": 95,
      "description": "Archive member names are absolute, carry a drive letter, contain a NUL byte or a `..` segment, so extracting the archive can write outside the target directory (zip slip).",
      "remediation": "Do not extract the archive with a tool that trusts member names. Obtain the model from a trusted source.",
      "maps_to": ["LLM03:2025 Supply Chain"],
      "references": ["https://security.snyk.io/research/zip-slip-vulnerability"],
      "quality": {"fp_rate_measured": null, "corpus": null, "evaluated_at": null}
    },
    "ait.model.gguf.chat-template-ssti": {
      "severity": "high",
      "verdict": "suspicious",
      "confidence": 80,
      "description": "The GGUF `tokenizer.chat_template` metadata contains Jinja server-side template injection markers (dunder attribute access, popen/subprocess/import). Runtimes that render the template without a sandbox execute code (CVE-2024-34359, llama-cpp-python).",
      "remediation": "Do not serve this model with a runtime that renders chat templates outside a Jinja sandbox; replace the template or obtain the model from a trusted publisher.",
      "maps_to": ["LLM03:2025 Supply Chain", "LLM04:2025 Data and Model Poisoning"],
      "references": ["https://nvd.nist.gov/vuln/detail/CVE-2024-34359"],
      "quality": {"fp_rate_measured": null, "corpus": null, "evaluated_at": null}
    },
    "ait.model.onnx.custom-op-domain": {
      "severity": "medium",
      "verdict": "suspicious",
      "confidence": 90,
      "description": "The ONNX graph uses operators from a non-standard domain (not '', ai.onnx, ai.onnx.ml, ai.onnx.training, ai.onnx.preview.training, a known runtime-vendor domain, or a model-local function domain). Running it requires a custom-operator library, i.e. native code supplied outside the model.",
      "remediation": "Identify the custom-op library the model needs and verify its provenance before registering it with the runtime.",
      "maps_to": ["LLM03:2025 Supply Chain"],
      "references": [],
      "quality": {"fp_rate_measured": null, "corpus": null, "evaluated_at": null}
    },
    "ait.model.onnx.vendor-op-domain": {
      "severity": "info",
      "verdict": "benign",
      "confidence": 90,
      "description": "The ONNX graph uses operators from a known runtime-vendor domain (for example com.microsoft contrib ops built into onnxruntime). Inventory only: the model is tied to that runtime.",
      "remediation": "None required; make sure the deployment runtime provides these operators.",
      "maps_to": [],
      "references": [],
      "quality": {"fp_rate_measured": null, "corpus": null, "evaluated_at": null}
    },
    "ait.model.onnx.external-data-path": {
      "severity": "high",
      "verdict": "suspicious",
      "confidence": 90,
      "description": "An ONNX tensor's external-data location is absolute or contains `..`, so loading the model reads a file outside the model directory (CVE-2022-25882, CVE-2024-27318).",
      "remediation": "Do not load the model with an onnx/onnxruntime version that follows such paths; obtain the model from a trusted source.",
      "maps_to": ["LLM03:2025 Supply Chain"],
      "references": ["https://nvd.nist.gov/vuln/detail/CVE-2022-25882", "https://nvd.nist.gov/vuln/detail/CVE-2024-27318"],
      "quality": {"fp_rate_measured": null, "corpus": null, "evaluated_at": null}
    },
    "ait.model.keras.lambda-layer": {
      "severity": "high",
      "verdict": "suspicious",
      "confidence": 95,
      "description": "The Keras model contains a Lambda layer, which serialises arbitrary Python (marshalled bytecode or a named function) that runs when the model is loaded or called (CVE-2024-3660 for Keras < 2.13). Raised to critical when the base64-decoded bytecode contains names on the token list (never unmarshalled; a byte search only). For HDF5 files the detection is a bounded byte search of the model_config JSON (heuristic).",
      "remediation": "Load only with safe_mode=True on a patched Keras, or rebuild the model without Lambda layers.",
      "maps_to": ["LLM03:2025 Supply Chain", "LLM04:2025 Data and Model Poisoning"],
      "references": ["https://nvd.nist.gov/vuln/detail/CVE-2024-3660"],
      "quality": {"fp_rate_measured": null, "corpus": null, "evaluated_at": null}
    },
    "ait.model.keras.dangerous-callable": {
      "severity": "critical",
      "verdict": "malicious",
      "confidence": 90,
      "description": "The Keras v3 config.json references a module/function on the pickle deny list (e.g. module 'os', function 'system'). Keras resolves these when it loads the model, even with safe_mode (CVE-2025-1550).",
      "remediation": "Do not load this model. Obtain it from a trusted publisher and upgrade Keras.",
      "maps_to": ["LLM03:2025 Supply Chain", "LLM04:2025 Data and Model Poisoning"],
      "references": ["https://nvd.nist.gov/vuln/detail/CVE-2025-1550"],
      "quality": {"fp_rate_measured": null, "corpus": null, "evaluated_at": null}
    },
    "ait.model.mar.handler-code": {
      "severity": "info",
      "verdict": "unknown",
      "confidence": 95,
      "description": "The TorchServe .mar archive ships custom handler Python code that the model server imports and runs when the model is served.",
      "remediation": "Review the handler code (and any requirements file it installs) before serving the archive.",
      "maps_to": ["LLM03:2025 Supply Chain"],
      "references": [],
      "quality": {"fp_rate_measured": null, "corpus": null, "evaluated_at": null}
    }
  },
  "limits": {
    "max_pickle_opcodes": 3000000,
    "max_pickles_per_stream": 64,
    "max_distinct_callables": 20000,
    "max_decompressed_bytes": 1073741824,
    "max_total_decompressed_bytes": 2147483648,
    "max_line_bytes": 16777216,
    "elide_arg_bytes": 1048576,
    "max_tracked_string": 4096,
    "max_tracked_container": 256,
    "max_zip_members": 100000,
    "max_nested_depth": 2,
    "max_nested_member_bytes": 1073741824,
    "max_json_bytes": 16777216,
    "max_npy_header_bytes": 65536,
    "max_safetensors_header_bytes": 100000000,
    "max_safetensors_header_parse_bytes": 33554432,
    "max_compression_ratio": 200,
    "compression_ratio_floor_bytes": 268435456,
    "max_memo_entries": 1000000,
    "max_tracked_string_bytes": 33554432,
    "max_gguf_templates": 64,
    "max_gguf_template_bytes": 4194304,
    "max_gguf_kv": 100000,
    "max_gguf_array": 50000000,
    "max_gguf_string_store": 1048576,
    "hdf5_head_bytes": 33554432,
    "hdf5_tail_bytes": 8388608,
    "max_onnx_fields": 20000000,
    "max_onnx_nodes": 2000000,
    "max_onnx_depth": 16,
    "evidence_per_finding": 5,
    "max_listed": 50
  },
  "pickle": {
    "module_aliases": {
      "__builtin__": "builtins",
      "exceptions": "builtins",
      "copy_reg": "copyreg",
      "cPickle": "pickle",
      "commands": "subprocess",
      "urllib2": "urllib.request",
      "httplib": "http.client",
      "SocketServer": "socketserver",
      "SimpleHTTPServer": "http.server",
      "UserDict": "collections"
    },
    "deny": [
      {"module": "os", "names": ["*"], "submodules": true, "category": "os-command"},
      {"module": "posix", "names": ["*"], "category": "os-command"},
      {"module": "nt", "names": ["*"], "category": "os-command"},
      {"module": "subprocess", "names": ["*"], "submodules": true, "category": "os-command"},
      {"module": "_posixsubprocess", "names": ["*"], "category": "os-command"},
      {"module": "_winapi", "names": ["*"], "category": "os-command"},
      {"module": "pty", "names": ["*"], "category": "os-command"},
      {"module": "popen2", "names": ["*"], "category": "os-command"},
      {"module": "platform", "names": ["popen", "_syscmd_*"], "category": "os-command"},
      {"module": "multiprocessing", "names": ["*"], "submodules": true, "category": "os-command"},
      {"module": "asyncio", "names": ["*"], "submodules": true, "category": "os-command"},
      {"module": "builtins", "names": ["eval", "exec", "execfile", "compile", "breakpoint", "input"], "category": "code-execution"},
      {"module": "builtins", "names": ["__import__"], "category": "dynamic-import"},
      {"module": "builtins", "names": ["getattr", "setattr", "delattr", "globals", "locals", "vars"], "category": "reflection"},
      {"module": "builtins", "names": ["open"], "category": "filesystem"},
      {"module": "operator", "names": ["attrgetter", "methodcaller"], "category": "reflection"},
      {"module": "_operator", "names": ["attrgetter", "methodcaller"], "category": "reflection"},
      {"module": "sys", "names": ["*"], "category": "reflection"},
      {"module": "types", "names": ["CodeType", "FunctionType", "LambdaType"], "category": "code-execution"},
