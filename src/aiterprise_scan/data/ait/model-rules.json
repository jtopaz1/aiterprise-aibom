  "formats": [
    {"id": "pickle", "extensions": [".pkl", ".pickle", ".pt", ".pth", ".ckpt", ".bin"], "signature": "PROTO opcode 0x80 + protocol byte (protocol 2-5); protocol 0/1 accepted only after a structural parse", "offset": 0, "analysis": "pickletools.genops opcode walk with symbolic stack + memo; never unpickled"},
    {"id": "pytorch-legacy", "extensions": [".pt", ".pth", ".bin", ".ckpt"], "signature": "first pickle is the integer 0x1950a86a20f9469cfc6c, followed by four more pickles and raw storages", "offset": 0, "analysis": "all five pickles walked"},
    {"id": "pytorch-zip", "extensions": [".pt", ".pth", ".bin", ".ckpt"], "signature": "ZIP (PK\\x03\\x04) with <archive>/data.pkl; TorchScript adds code/ and constants.pkl", "offset": 0, "analysis": "every .pkl member walked; CRC verified independently (PyTorch does not)"},
    {"id": "joblib", "extensions": [".joblib", ".pkl", ".pickle"], "signature": "pickle, legacy 'ZF0x' zlib header, raw zlib (0x78), gzip (1f 8b), bz2 (BZh), xz (fd 37 7a 58 5a 00), lzma-alone (5d 00 00); lz4 frame (04 22 4d 18) is detected but not decompressable with the standard library", "offset": 0, "analysis": "decompressed with caps; NumpyArrayWrapper raw array payloads skipped, object arrays walked as nested pickles"},
    {"id": "numpy-npy", "extensions": [".npy"], "signature": "\\x93NUMPY", "offset": 0, "analysis": "header parsed with ast.literal_eval (literals only); object dtype payload walked as a pickle"},
    {"id": "numpy-npz", "extensions": [".npz"], "signature": "ZIP of .npy members", "offset": 0, "analysis": "each .npy member analysed"},
    {"id": "safetensors", "extensions": [".safetensors"], "signature": "u64 LE header length + '{' JSON header", "offset": 0, "analysis": "bounds, dtype x shape and contiguity validated; safe by format"},
    {"id": "gguf", "extensions": [".gguf"], "signature": "GGUF", "offset": 0, "analysis": "versions 1-3; bounded KV metadata parse; general.* inventoried; chat template checked for SSTI markers"},
    {"id": "ggml", "extensions": [".bin"], "signature": "legacy GGML magics lmgg/fmgg/tjgg/algg", "offset": 0, "analysis": "inventory only"},
    {"id": "onnx", "extensions": [".onnx"], "signature": "none (protobuf); confirmed by parsing ModelProto (ir_version / graph)", "offset": 0, "analysis": "minimal streaming protobuf decode: opset_import, node op_type/domain (incl. subgraphs and functions), tensor external_data"},
    {"id": "hdf5", "extensions": [".h5", ".hdf5"], "signature": "\\x89HDF\\r\\n\\x1a\\n (offset 0 or a power-of-two user block from 512)", "offset": 0, "analysis": "bounded byte search (first 32 MiB, last 8 MiB) for Keras markers and Lambda layers; heuristic"},
    {"id": "keras", "extensions": [".keras"], "signature": "ZIP with config.json (+ metadata.json / model.weights.h5)", "offset": 0, "analysis": "config.json walked for Lambda layers and deny-listed module/function references"},
    {"id": "tflite", "extensions": [".tflite"], "signature": "FlatBuffer file identifier TFL3", "offset": 4, "analysis": "inventory only (schema version, description)"},
    {"id": "executorch", "extensions": [".pte"], "signature": "not asserted: the FlatBuffer identifier at offset 4 is recorded but not trusted", "offset": 4, "analysis": "inventory only; format_confidence extension-only"},
    {"id": "torchserve-mar", "extensions": [".mar"], "signature": "ZIP with MAR-INF/MANIFEST.json", "offset": 0, "analysis": "manifest inventoried; custom handler code noted; embedded model files analysed recursively"}
  ]
