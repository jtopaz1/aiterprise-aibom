      {"module": "torch.hub", "names": ["*"], "submodules": true, "category": "nested-deserializer"},
      {"module": "torch.jit", "names": ["load"], "submodules": true, "category": "nested-deserializer"},
      {"module": "numpy", "names": ["load"], "category": "nested-deserializer"},
      {"module": "numpy.lib.npyio", "names": ["load"], "category": "nested-deserializer"},
      {"module": "numpy.lib._npyio_impl", "names": ["load"], "category": "nested-deserializer"},
      {"module": "joblib", "names": ["load"], "category": "nested-deserializer"},
      {"module": "joblib.numpy_pickle", "names": ["load"], "category": "nested-deserializer"},
