      {"module": "io", "names": ["open", "open_code", "FileIO"], "category": "filesystem"},
      {"module": "_io", "names": ["open", "open_code", "FileIO"], "category": "filesystem"},
      {"module": "codecs", "names": ["open"], "category": "filesystem"},
      {"module": "shutil", "names": ["rmtree", "move", "copy", "copy2", "copyfile", "copyfileobj", "copytree", "chown", "make_archive", "unpack_archive"], "category": "filesystem"},
      {"module": "pathlib", "names": ["*Path.write_*", "*Path.read_*", "*Path.open", "*Path.unlink", "*Path.rmdir", "*Path.rename", "*Path.replace", "*Path.chmod", "*Path.touch", "*Path.mkdir", "*Path.symlink_to", "*Path.hardlink_to"], "category": "filesystem"},
      {"module": "tarfile", "names": ["open", "TarFile.extract*", "TarFile.open"], "category": "filesystem"},
      {"module": "pickle", "names": ["load", "loads", "_load", "_loads", "Unpickler", "_Unpickler"], "category": "nested-deserializer"},
