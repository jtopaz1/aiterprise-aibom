      {"module": "logging.config", "names": ["*"], "category": "code-execution"},
      {"module": "numpy.testing._private.utils", "names": ["runstring"], "category": "code-execution"},
      {"module": "importlib", "names": ["*"], "submodules": true, "category": "dynamic-import"},
      {"module": "imp", "names": ["*"], "category": "dynamic-import"},
      {"module": "pkgutil", "names": ["*"], "category": "dynamic-import"},
      {"module": "zipimport", "names": ["*"], "category": "dynamic-import"},
      {"module": "pip", "names": ["*"], "submodules": true, "category": "package-install"},
