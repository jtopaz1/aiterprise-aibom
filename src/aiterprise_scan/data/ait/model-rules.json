    "allow": [
      {"module": "builtins", "names": ["set", "frozenset", "dict", "list", "tuple", "bytearray", "bytes", "int", "float", "complex", "bool", "str", "slice", "range", "object", "Ellipsis", "NotImplemented"], "category": "python-builtin-type"},
